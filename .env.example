# 本機開發：後端預設 http://localhost:8085（context-path /management）
# VITE_API_URL=http://localhost:8085

# 後端 API 基底（正式環境請指向 Cloud Run）
VITE_API_URL=https://weiyu-api-xxxxx-asia-east1.run.app

# 本機 dev server 固定 http://localhost:5173（見 vite.config.ts）

# GitHub Actions Variable（非本機 .env 必填）：Firebase Hosting 站點 ID
# Settings → Secrets and variables → Actions → Variables
# VITE_FIREBASE_HOSTING_SITE=weiyu-construction-manager

# Google Maps（基本資料 → 工程地點地圖選點；需啟用 Maps JavaScript API + Geocoding API）
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 中央氣象署 API（Dashboard 縣市預報；測站推算由後端 CWA_API_TOKEN 處理）
# VITE_CWA_API_TOKEN=your_cwa_token
