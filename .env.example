VITE_FIREBASE_AUTH_DOMAIN=weiyu-engineering-smart.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=weiyu-engineering-smart
VITE_FIREBASE_STORAGE_BUCKET=weiyu-engineering-smart.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=333590647067
VITE_FIREBASE_APP_ID=1:333590647067:web:57c8a80635aaec92a783be
